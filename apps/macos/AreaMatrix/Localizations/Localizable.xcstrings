      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repository diagnostics copy AreaMatrix metadata and may include paths, file names, tags, notes, and other sensitive metadata. Original file contents are not copied, and diagnostics are not uploaded automatically. Review the snapshot before sharing."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
